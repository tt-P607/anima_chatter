{
    "name": "voice_chatter",
    "version": "1.1.0",
    "description": "ASR 实时语音通话 + VTube Studio 虚拟形象 通用 Chatter",
    "author": "MoFox Team",
    "dependencies": {
        "plugins": ["asr_adapter", "tts_http_server"],
        "components": []
    },
    "python_dependencies": [
        "pyvts>=0.3.3"
    ],
    "include": [
        {
            "component_type": "chatter",
