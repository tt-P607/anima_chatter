{
    "name": "anima_chatter",
    "display_name": "Anima 语音通话与虚拟形象聊天器",
    "version": "1.2.0",
    "description": "统一编排实时语音通话、VTube Studio 表演和直播弹幕互动的三模式 Chatter。",
    "author": "言柒",
    "entry_point": "plugin.py",
    "min_core_version": "1.2.0-alpha",
    "api_version": {
        "adapter_api": "1.0.0",
        "chat_api": "1.0.0",
        "event_api": "1.0.0",
        "llm_api": "1.0.0",
        "log_api": "1.0.0",
        "plugin_api": "1.0.0",
        "send_api": "1.0.0",
        "service_api": "1.0.0",
        "stream_api": "1.0.0"
    },
    "dependencies": {
        "plugins": [
            "asr_adapter_anima",
            "tts_http_server",
            "default_chatter"
        ],
        "components": [
            "default_chatter:service:chat_core",
            "asr_adapter_anima:service:asr_redirect",
            "tts_http_server:service:tts_provider_registry"
        ]
    },
    "python_dependencies": [
        "pyvts>=0.3.3",
        "websockets>=12.0",
        "sounddevice>=0.4.6",
        "soundfile>=0.12.1",
        "rapidfuzz>=3.0.0",
        "numpy>=1.24.0"
    ],
    "include": [
        {
            "component_type": "chatter",
            "component_name": "anima_chatter",
            "dependencies": [
                "default_chatter:service:chat_core"
            ]
        },
        {
            "component_type": "action",
            "component_name": "say",
            "dependencies": []
        },
        {
            "component_type": "action",
            "component_name": "say_and_perform",
            "dependencies": []
        },
        {
            "component_type": "action",
            "component_name": "sing_song",
            "dependencies": []
        },
        {
            "component_type": "action",
            "component_name": "pass_and_wait",
            "dependencies": []
        },
        {
            "component_type": "action",
            "component_name": "start_voice_call",
            "dependencies": [
                "asr_adapter_anima:service:asr_redirect"
            ]
        },
        {
            "component_type": "action",
            "component_name": "end_voice_call",
            "dependencies": [
                "asr_adapter_anima:service:asr_redirect"
            ]
        },
        {
            "component_type": "command",
            "component_name": "voice",
            "dependencies": []
        },
        {
            "component_type": "command",
            "component_name": "vtb",
            "dependencies": []
        }
    ],
    "categories": [
        "chat"
    ],
    "tags": [
        "voice",
        "chatter",
        "real-time",
        "tts",
        "vtube-studio",
        "live"
    ]
}
